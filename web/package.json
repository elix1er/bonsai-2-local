{
  "name": "bonsai-chat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "bun run typecheck && bun --bun vite build",
    "start": "bun server.ts",
    "test": "bun --bun vitest run && bun --bun playwright test",
    "format": "prettier --write *.ts *.css *.html tests/*.ts",
    "format:check": "prettier --check *.ts *.css *.html tests/*.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "dompurify": "3.4.16",
    "marked": "18.0.14",
    "valibot": "1.5.0"
  },
  "packageManager": "bun@1.4.2"
}
